{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && npm run build:api && esbuild server.ts --bundle --platform=node --format=cjs --external:fs --external:path --external:os --external:crypto --external:http --external:https --external:net --external:tls --external:stream --external:zlib --external:url --external:events --external:buffer --external:util --external:child_process --external:cluster --external:dns --external:readline --sourcemap --outfile=dist/server.cjs",
    "build:api": "esbuild api/handler.ts --bundle --platform=node --format=esm --packages=external --outfile=api/index.js",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js api/index.js",
    "lint": "tsc --noEmit",
    "migrate:accounts": "tsx scripts/migrate-accounts.ts",
    "verify:logins": "tsx scripts/verify-logins.ts",
    "build:mobile": "vite build && npm run build:api && npx cap sync android",
    "build:apk": "npm run build:api && npx cap sync android && cd android && gradlew.bat assembleDebug",
    "cap:sync": "npx cap sync android",
    "cap:open:android": "npx cap open android",
    "android:apk": "cd android && gradlew.bat assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/app": "^6.0.3",
    "@capacitor/core": "^6.2.1",
    "@capacitor/device": "^6.0.3",
    "@capacitor/local-notifications": "^6.1.3",
    "@capacitor/push-notifications": "^6.0.5",
    "@capacitor/splash-screen": "^6.0.4",
    "@google/genai": "^2.4.0",
    "@supabase/supabase-js": "^2.111.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@vercel/node": "^6.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase-admin": "^14.3.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "undici": "^6.28.0",
    "uuid": "^14.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
