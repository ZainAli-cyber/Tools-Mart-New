<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Adaptive icon safe zone: inset so the logo is not cropped/zoomed -->
    <item
        android:top="22dp"
        android:bottom="22dp"
        android:left="22dp"
        android:right="22dp">
        <bitmap
            android:gravity="fill"
            android:src="@drawable/logo" />
    </item>
</layer-list>
