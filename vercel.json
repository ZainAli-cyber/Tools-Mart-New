{
  "buildCommand": "vite build && npm run build:api",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/fx", "destination": "/api" },
    { "source": "/fx/(.*)", "destination": "/api" },
    { "source": "/go", "destination": "/api" },
    { "source": "/go/(.*)", "destination": "/api" },
    { "source": "/backend-api/(.*)", "destination": "/api" },
    { "source": "/public-api/(.*)", "destination": "/api" },
    { "source": "/backend-anon/(.*)", "destination": "/api" },
    { "source": "/ces/(.*)", "destination": "/api" },
    {
      "source": "/(.*)",
      "has": [{ "type": "header", "key": "referer", "value": ".*/fx/.*" }],
      "destination": "/api"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 60
    }
  }
}
