{
  "buildCommand": "vite build && npm run build:api",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/fx", "destination": "/api" },
    { "source": "/fx/(.*)", "destination": "/api" },
    { "source": "/go", "destination": "/api" },
    { "source": "/go/(.*)", "destination": "/api" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 60
    }
  }
}
